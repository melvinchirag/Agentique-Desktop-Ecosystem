# Copy to .env and fill in. NEVER commit .env. Share keys privately, not in the repo.

# Brain. Leave empty for Backboard (needs the keys below). Or name the AI installed and signed in on this
# machine: claude-cli (Claude Code), codex-cli (OpenAI Codex), gemini-cli (Google Gemini CLI). Then no
# Backboard key or BB_ASSISTANT ids are needed.
ADE_BRAIN=
# Optional: full path to the executable if it is not on PATH.
ADE_CLAUDE_BIN=
ADE_CODEX_BIN=
ADE_GEMINI_BIN=

BACKBOARD_API_KEY=
BB_ASSISTANT_CHIPMUNK=
BB_ASSISTANT_WORKSPACE=
BB_ASSISTANT_WOLF=
BB_ASSISTANT_BEAVER=
BB_ASSISTANT_EAGLE=
BB_ASSISTANT_ANTS=
BB_ASSISTANT_BUTTERFLY=
BB_ASSISTANT_NIGHTINGALE=

ELEVENLABS_API_KEY=
EL_VOICE_CHIPMUNK=
EL_VOICE_WORKSPACE=
EL_VOICE_WOLF=
EL_VOICE_BEAVER=
EL_VOICE_EAGLE=
EL_VOICE_ANTS=
EL_VOICE_BUTTERFLY=
EL_VOICE_NIGHTINGALE=

TIGER_DATABASE_URL=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
